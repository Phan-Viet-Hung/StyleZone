@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("--- SCRIPT MUA NGAY (FORM DATA VERSION) ---");

            // 1. Cấu hình API & Data
            const apiLocalGHN = "@(fullApiUrl)GHN/";
            const serviceId = 53320;

            let subTotal = 0;
            try { subTotal = @((long)Model.Total); } catch (e) { subTotal = 0; }

            // 2. DOM Elements
            const el = {
                province: document.getElementById("province"),
                district: document.getElementById("district"),
                ward: document.getElementById("ward"),
                shipText: document.getElementById("shippingFeeText"),
                totalText: document.getElementById("totalAmount"),
                shipInput: document.getElementById("ShippingFee"),
                totalInput: document.getElementById("TotalAmount"),
                btnSubmit: document.getElementById("btnCompleteOrder"),
                fullName: document.getElementById("fullName"),
                phone: document.getElementById("phoneNumber"),
                address: document.getElementById("address"),
                note: document.getElementById("orderNote"),
                voucher: document.getElementById("SelectedVoucherId"),
                provName: document.getElementById("Province"),
                distName: document.getElementById("District"),
                wardName: document.getElementById("Ward")
            };

            // 3. API Helper (GHN)
            async function callApi(endpoint, method = 'GET', body = null) {
                try {
                    const opt = { method: method, headers: { "Content-Type": "application/json" } };
                    if (body) opt.body = JSON.stringify(body);
                    const res = await fetch(apiLocalGHN + endpoint, opt);
                    return res.ok ? await res.json() : [];
                } catch (err) { return []; }
            }

            // 4. Logic Load Địa chỉ (Giữ nguyên như cũ)
            async function loadProvinces() {
                if (!el.province) return;
                const data = await callApi("provinces");
                let html = '<option value="">Tỉnh / thành</option>';
                if (Array.isArray(data)) {
                    data.forEach(p => html += `<option value="${p.ProvinceID}">${p.ProvinceName}</option>`);
                }
                el.province.innerHTML = html;
            }

            // --- Events Địa chỉ ---
            if (el.province) {
                el.province.addEventListener("change", async function () {
                    const pid = this.value;
                    el.district.innerHTML = '<option value="">Đang tải...</option>'; el.district.disabled = true;
                    el.ward.innerHTML = '<option value="">Phường / xã</option>'; el.ward.disabled = true;
                    resetShipping();
                    if (!pid) return;
                    if(el.provName) el.provName.value = this.options[this.selectedIndex].text;
                    const data = await callApi("districts", "POST", { province_id: parseInt(pid) });
                    let html = '<option value="">Quận / huyện</option>';
                    data.forEach(d => html += `<option value="${d.DistrictID}">${d.DistrictName}</option>`);
                    el.district.innerHTML = html; el.district.disabled = false;
                });
            }

            if (el.district) {
                el.district.addEventListener("change", async function () {
                    const did = this.value;
                    el.ward.innerHTML = '<option value="">Đang tải...</option>'; el.ward.disabled = true;
                    resetShipping();
                    if (!did) return;
                    if(el.distName) el.distName.value = this.options[this.selectedIndex].text;
                    const data = await callApi("wards", "POST", { district_id: parseInt(did) });
                    let html = '<option value="">Phường / xã</option>';
                    data.forEach(w => html += `<option value="${w.WardCode}">${w.WardName}</option>`);
                    el.ward.innerHTML = html; el.ward.disabled = false;
                });
            }

            if (el.ward) {
                el.ward.addEventListener("change", async function () {
                    if (el.district.value && this.value) {
                        if(el.wardName) el.wardName.value = this.options[this.selectedIndex].text;
                        const body = {
                            service_id: serviceId, insurance_value: subTotal, from_district_id: 1482,
                            to_district_id: parseInt(el.district.value), to_ward_code: this.value,
                            height: 5, length: 30, weight: 300, width: 25
                        };
                        const res = await callApi("calculate-fee", "POST", body);
                        if (res && res.total_fee !== undefined) {
                            const fee = res.total_fee;
                            const total = subTotal + fee;
                            if(el.shipText) el.shipText.textContent = fee.toLocaleString('vi-VN') + "₫";
                            if(el.totalText) el.totalText.textContent = total.toLocaleString('vi-VN') + "₫";
                            if(el.shipInput) el.shipInput.value = fee;
                            if(el.totalInput) el.totalInput.value = total;
                        }
                    }
                });
            }

            function resetShipping() {
                if(el.shipText) el.shipText.textContent = "0₫";
                if(el.totalText) el.totalText.textContent = subTotal.toLocaleString('vi-VN') + "₫";
                if(el.shipInput) el.shipInput.value = 0;
                if(el.totalInput) el.totalInput.value = subTotal;
            }

            // ============================================================
            // 👇 5. XỬ LÝ NÚT ĐẶT HÀNG (SỬ DỤNG FORMDATA) 👇
            // ============================================================
            if (el.btnSubmit) {
                el.btnSubmit.type = "button"; // Chặn submit mặc định

                el.btnSubmit.addEventListener("click", async function () {
                    // Validate
                    const paymentMethod = document.querySelector("input[name='PaymentMethodCode']:checked");
                    if (!paymentMethod) { alert("Vui lòng chọn phương thức thanh toán."); return; }
                    if (!el.fullName.value.trim()) { alert("Vui lòng nhập họ tên."); return; }
                    if (!el.phone.value.trim()) { alert("Vui lòng nhập số điện thoại."); return; }
                    if (!el.address.value.trim()) { alert("Vui lòng nhập địa chỉ."); return; }
                    if (el.province.value === "" || el.district.value === "" || el.ward.value === "") {
                        alert("Vui lòng chọn đầy đủ địa chỉ."); return;
                    }

                    // === TẠO FORMDATA (Thay vì JSON) ===
                    const formData = new FormData();
                    formData.append("FullName", el.fullName.value.trim());
                    formData.append("PhoneNumber", el.phone.value.trim());
                    formData.append("Address", el.address.value.trim());
                    formData.append("GhiChu", el.note ? el.note.value : "");
                    formData.append("VorcherId", el.voucher ? el.voucher.value : "");

                    // Dữ liệu 1 sản phẩm nhưng phải đặt tên theo kiểu mảng OrderItems[0]
                    formData.append("OrderItems[0].ProductDetailId", '@Model.ProductDetailId');
                    formData.append("OrderItems[0].Quantity", @Model.Quantity);
                    formData.append("OrderItems[0].Price", @((long)Model.Price));

                    formData.append("PaymentMethodCode", paymentMethod.value);
                    formData.append("TotalAmount", el.totalInput.value);
                    formData.append("IsFromCart", "false");

                    // Gửi cả phí ship nếu cần
                    formData.append("ShippingFee", el.shipInput.value);

                    try {
                        const res = await fetch("/MoMoThanhtoancustomer/CreateGuestOrder", {
                            method: "POST",
                            // ⚠️ QUAN TRỌNG: Không set Content-Type khi dùng FormData
                            // Browser sẽ tự set là multipart/form-data
                            body: formData
                        });

                        if (res.redirected && res.ok) {
                            const htmlContent = await res.text();
                            
                            // Mở document để ghi đè nội dung mới (Trang Home + Alert thành công)
                            document.open();
                            document.write(htmlContent);
                            document.close();

                            // Cập nhật lại thanh URL cho đẹp (thành /Home/Index)
                            window.history.pushState({}, "", res.url);
                        } 
                        else {
                            // Trường hợp lỗi (400/500) hoặc MoMo URL (dạng text/plain)
                            // Nếu là MoMo (có URL thanh toán trong body hoặc header)
                             window.location.reload();
                        }
                    } catch (error) {
                        console.error("Lỗi submit:", error);
                        alert("Lỗi kết nối tới máy chủ.");
                    }
                });
            }

            loadProvinces();
        });
    </script>
}
